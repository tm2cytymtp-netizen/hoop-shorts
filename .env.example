# ---- Copy to .env and fill in. Never commit .env. ----

# Public HTTPS address of this app — Zapier fetches your Shorts from here (also used for Google OAuth)
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000
# Dashboard login (strongly recommended — required when it's reachable from the internet)
DASHBOARD_PASSWORD=
DASHBOARD_TOKEN=            # optional alternative: a fixed API token
# Encrypts your YouTube refresh token at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=                  # only needed for the youtube_api method

# Database: SQLite by default. For Postgres/Supabase use e.g.
#   postgresql+psycopg://user:pass@host:5432/dbname
# DATABASE_URL=

# ---- FREE AI stack (default) ----
GEMINI_API_KEY=             # free: https://aistudio.google.com/apikey  (scripts, fact-checking)
CLOUDFLARE_ACCOUNT_ID=      # free Cloudflare account → Workers AI (images, 10,000 free neurons/day)
CLOUDFLARE_API_TOKEN=       # My Profile → API Tokens → Create → template "Workers AI"
BALLDONTLIE_API_KEY=        # free: app.balldontlie.io (real NBA scores & games; free tier = 5 requests/min)
# Narration (Kokoro) runs on your computer — no key. Player photos come from Wikimedia Commons — no key.
# Headlines come from public ESPN / Google News RSS — no key.

# ---- Optional PAID upgrades (switch providers in Settings → AI providers / Voice) ----
ANTHROPIC_API_KEY=          # Claude + live web search instead of Gemini + Wikipedia
FAL_KEY=                    # higher-quality images + AI motion clips
ELEVENLABS_API_KEY=         # premium voices (paid plan for commercial use)

# ---- Only for the youtube_api publishing method (not needed with Zapier or the weekly pack) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=            # optional with ANY method: free API key so topic research can see trending Shorts

# ---- Notifications (optional) ----
NOTIFY_WEBHOOK_URL=         # Discord or Slack incoming webhook
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# ---- Rendering ----
X264_PRESET=medium          # 'slow' = slightly better quality, 'veryfast' = quick drafts
X264_CRF=18
